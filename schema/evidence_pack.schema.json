{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hmoney.local/schema/evidence_pack.schema.json",
  "title": "HMoney Evidence Pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pack_id",
    "run_id",
    "generated_at_utc",
    "as_of_utc",
    "asset",
    "market",
    "scores",
    "classification",
    "deployment_bias",
    "explainability"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "pack_id": {
      "type": "string",
      "description": "Unique identifier for this pack (UUID recommended)."
    },
    "run_id": {
      "type": "string",
      "description": "Identifier for the pipeline run (e.g., YYYY-MM-DD/HHMM)."
    },
    "generated_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "as_of_utc": {
      "type": "string",
      "format": "date-time"
    },
    "data_freshness_sec": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["symbol", "asset_type"],
      "properties": {
        "symbol": { "type": "string" },
        "asset_type": {
          "type": "string",
          "enum": ["equity", "etf", "crypto"]
        },
        "name": { "type": ["string", "null"] },
        "exchange": { "type": ["string", "null"] },
        "sector": { "type": ["string", "null"] },
        "industry": { "type": ["string", "null"] }
      }
    },
    "portfolio_context": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "weight_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "tag": { "type": "string" }
      }
    },
    "market": {
      "type": "object",
      "additionalProperties": false,
      "required": ["last_price"],
      "properties": {
        "last_price": { "type": "number" },
        "currency": { "type": ["string", "null"] },
        "pct_change_1d": { "type": ["number", "null"] },
        "volume": { "type": ["number", "null"] },
        "avg_volume_20d": { "type": ["number", "null"] },
        "ma_50": { "type": ["number", "null"] },
        "ma_200": { "type": ["number", "null"] },
        "rsi_14": { "type": ["number", "null"] },
        "pct_off_52w_high": { "type": ["number", "null"] },
        "atr_pct": { "type": ["number", "null"] }
      }
    },
    "fundamentals": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "market_cap": { "type": ["number", "null"] },
        "ttm_revenue": { "type": ["number", "null"] },
        "ttm_net_income": { "type": ["number", "null"] },
        "free_cash_flow": { "type": ["number", "null"] },
        "debt_to_equity": { "type": ["number", "null"] }
      }
    },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": ["opportunity_score", "structural_risk_score"],
      "properties": {
        "opportunity_score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "structural_risk_score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "discount_score": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "confidence"],
      "properties": {
        "label": {
          "type": "string",
          "enum": ["🟢", "🟡", "🔵", "🟠", "🔴"]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "deployment_bias": {
      "type": "string",
      "enum": ["deploy", "watch", "hold", "reduce", "avoid"]
    },
    "explainability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason_codes"],
      "properties": {
        "reason_codes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "notes": { "type": ["string", "null"] }
      }
    },

    "links": {
      "type": ["object", "null"],
      "description": "Human-clickable links (quote pages, methodology, filings, etc.). Open-ended for future providers.",
      "additionalProperties": {
        "anyOf": [
          { "type": "string" },
          { "type": "null" }
        ]
      }
    },
    "field_links": {
      "type": ["object", "null"],
      "description": "Map from field path (e.g., 'market.last_price') to a URL explaining/sourcing that field.",
      "additionalProperties": {
        "type": ["string", "null"],
        "format": "uri"
      }
    },
    "provenance": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "description": "Optional structured provenance for providers and notes; safe to extend later by bumping schema.",
      "properties": {
        "primary_provider": { "type": ["string", "null"] },
        "providers": {
          "type": ["object", "null"],
          "additionalProperties": {
            "anyOf": [
              { "type": "string" },
              { "type": "number" },
              { "type": "boolean" },
              { "type": "null" },
              { "type": "object" },
              { "type": "array" }
            ]
          }
        },
        "notes": { "type": ["string", "null"] }
      }
    }
  }
}